{
    "name": "pulse/api",
    "description": "Pulse uptime monitor: REST API, database migrations and console commands",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "predis/predis": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Pulse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pulse\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration"
    }
}
